{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "downloads_30d": {
          "minimum": 0,
          "title": "Downloads 30D",
          "type": "integer"
        },
        "facts": {
          "$ref": "#/$defs/_CandidateFacts"
        },
        "facts_from": {
          "title": "Facts From",
          "type": "string"
        },
        "gated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "default": false,
          "title": "Gated"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "tasks": {
          "items": {
            "enum": [
              "chat",
              "coding"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "repo",
        "facts_from",
        "publisher",
        "tasks",
        "created_at",
        "downloads_30d",
        "facts"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a number came from. Required on every record (lightweight rule 2).",
      "properties": {
        "fetched_at": {
          "title": "Fetched At",
          "type": "string"
        },
        "hand": {
          "default": false,
          "title": "Hand",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "fetched_at"
      ],
      "title": "Source",
      "type": "object"
    },
    "_CandidateFacts": {
      "additionalProperties": false,
      "properties": {
        "context_max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Max"
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "extra": {
          "additionalProperties": true,
          "title": "Extra",
          "type": "object"
        },
        "head_dim": {
          "exclusiveMinimum": 0,
          "title": "Head Dim",
          "type": "integer"
        },
        "num_kv_heads": {
          "exclusiveMinimum": 0,
          "title": "Num Kv Heads",
          "type": "integer"
        },
        "num_layers": {
          "exclusiveMinimum": 0,
          "title": "Num Layers",
          "type": "integer"
        },
        "params_active": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Params Active"
        },
        "params_total": {
          "exclusiveMinimum": 0,
          "title": "Params Total",
          "type": "integer"
        }
      },
      "required": [
        "params_total",
        "num_layers",
        "num_kv_heads",
        "head_dim"
      ],
      "title": "_CandidateFacts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "data/models/candidates.yaml, generated by scripts/ingest_candidates.py.",
  "properties": {
    "models": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "minItems": 1,
      "title": "Models",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Source"
    },
    "superseded": {
      "items": {
        "type": "string"
      },
      "title": "Superseded",
      "type": "array"
    }
  },
  "required": [
    "provenance",
    "models"
  ],
  "title": "CandidatesFile",
  "type": "object"
}
