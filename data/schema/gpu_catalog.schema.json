{
  "$defs": {
    "CatalogRecord": {
      "additionalProperties": false,
      "properties": {
        "compute_capability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compute Capability"
        },
        "gfx_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gfx Version"
        },
        "kind": {
          "enum": [
            "gpu",
            "cpu",
            "apple"
          ],
          "title": "Kind",
          "type": "string"
        },
        "memory_gib": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Gib"
        },
        "msrp_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Msrp Usd"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "power_w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power W"
        },
        "provenance": {
          "$ref": "#/$defs/Source"
        },
        "release_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Year"
        },
        "sku": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Sku",
          "type": "array"
        },
        "tflops": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tflops"
        },
        "vendor": {
          "enum": [
            "nvidia",
            "amd",
            "intel",
            "apple",
            "qualcomm",
            "cpu",
            "other"
          ],
          "title": "Vendor",
          "type": "string"
        }
      },
      "required": [
        "sku",
        "kind",
        "vendor",
        "name",
        "provenance"
      ],
      "title": "CatalogRecord",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a number came from. Required on every record (lightweight rule 2).",
      "properties": {
        "fetched_at": {
          "title": "Fetched At",
          "type": "string"
        },
        "hand": {
          "default": false,
          "title": "Hand",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "fetched_at"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "data/hardware/gpus.yaml, generated by scripts/ingest_hf_hardware.py.",
  "properties": {
    "devices": {
      "items": {
        "$ref": "#/$defs/CatalogRecord"
      },
      "title": "Devices",
      "type": "array"
    }
  },
  "required": [
    "devices"
  ],
  "title": "GpuCatalogFile",
  "type": "object"
}
