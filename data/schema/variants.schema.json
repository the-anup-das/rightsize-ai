{
  "$defs": {
    "QuantPublisher": {
      "additionalProperties": false,
      "properties": {
        "formats": {
          "items": {
            "type": "string"
          },
          "title": "Formats",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "name",
        "formats",
        "note",
        "source"
      ],
      "title": "QuantPublisher",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a number came from. Required on every record (lightweight rule 2).",
      "properties": {
        "fetched_at": {
          "title": "Fetched At",
          "type": "string"
        },
        "hand": {
          "default": false,
          "title": "Hand",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "fetched_at"
      ],
      "title": "Source",
      "type": "object"
    },
    "VariantFormat": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "libraries": {
          "description": "Hub library_name values",
          "items": {
            "type": "string"
          },
          "title": "Libraries",
          "type": "array"
        },
        "name_patterns": {
          "description": "regexes on the repo name",
          "items": {
            "type": "string"
          },
          "title": "Name Patterns",
          "type": "array"
        },
        "quant_patterns": {
          "description": "regexes whose first group is the quantization",
          "items": {
            "type": "string"
          },
          "title": "Quant Patterns",
          "type": "array"
        },
        "runtimes": {
          "items": {
            "type": "string"
          },
          "title": "Runtimes",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "tags": {
          "description": "Hub tags, any case",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "source"
      ],
      "title": "VariantFormat",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "data/models/variants.yaml: how quantized copies of a model are published on the Hub.",
  "properties": {
    "formats": {
      "items": {
        "$ref": "#/$defs/VariantFormat"
      },
      "minItems": 1,
      "title": "Formats",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Source"
    },
    "publishers": {
      "items": {
        "$ref": "#/$defs/QuantPublisher"
      },
      "title": "Publishers",
      "type": "array"
    },
    "strip_patterns": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Strip Patterns",
      "type": "array"
    }
  },
  "required": [
    "provenance",
    "strip_patterns",
    "formats"
  ],
  "title": "VariantsFile",
  "type": "object"
}
