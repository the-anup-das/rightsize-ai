{
  "$defs": {
    "CuratedModel": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "downloads_30d": {
          "minimum": 0,
          "title": "Downloads 30D",
          "type": "integer"
        },
        "family": {
          "enum": [
            "diffusion",
            "audio",
            "vision",
            "embedding"
          ],
          "title": "Family",
          "type": "string"
        },
        "gated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "default": false,
          "title": "Gated"
        },
        "library": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Library"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "params_total": {
          "exclusiveMinimum": 0,
          "title": "Params Total",
          "type": "integer"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "tasks": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "repo",
        "family",
        "tasks",
        "publisher",
        "params_total",
        "created_at",
        "downloads_30d"
      ],
      "title": "CuratedModel",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a number came from. Required on every record (lightweight rule 2).",
      "properties": {
        "fetched_at": {
          "title": "Fetched At",
          "type": "string"
        },
        "hand": {
          "default": false,
          "title": "Hand",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "fetched_at"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "data/models/families.yaml, generated by scripts/ingest_families.py.",
  "properties": {
    "models": {
      "items": {
        "$ref": "#/$defs/CuratedModel"
      },
      "minItems": 1,
      "title": "Models",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Source"
    },
    "tasks": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "propertyNames": {
        "enum": [
          "diffusion",
          "audio",
          "vision",
          "embedding"
        ]
      },
      "title": "Tasks",
      "type": "object"
    }
  },
  "required": [
    "provenance",
    "tasks",
    "models"
  ],
  "title": "FamiliesFile",
  "type": "object"
}
